# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Runtime data (BananaWiki keeps everything under the instance directory)
/instance/
/logs/
*.log
*.db
*.db-wal
*.db-shm
/backups/

# Data folders of 1.4 installations inside the source tree. BananaWiki 1.6
# moves their contents into the instance directory on first start; the
# patterns keep `git pull` and `git status` clean until then.
/app/
/plugins/external/
/translations/
/hosting/data/

# Secrets and archives that must never be committed
.env
**/.secret_key
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.agekey
*.age
*.bwplugin
*.tar.gz
*.tgz

.DS_Store
