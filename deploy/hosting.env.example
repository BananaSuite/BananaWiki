# Copy to an operator-owned environment file and set your own values.
BASE_DOMAIN=example.org
PORTAL_DOMAIN=hosting.example.org
INSTANCE_URL_SUFFIX=hosting
HOSTING_HOST=127.0.0.1
HOSTING_PORT=5099
HOSTING_PROXY_MODE=1
HOSTING_INSTANCE_RUNTIME=docker
HOSTING_CONTAINER_IMAGE=bananawiki-tenant:public
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
HOSTING_BOOTSTRAP_TOKEN=
# Enable custom domains after installing the Caddy hosting configuration.
HOSTING_CUSTOM_DOMAIN_TARGET=domains.example.org
HOSTING_CUSTOM_DOMAIN_IPS=
HOSTING_EMAIL_FROM=
HOSTING_EMAIL_REPLY_TO=
# Where the portal, its emails and its help centre tell people to write.
# Defaults to the reply-to address, then to contact@ your BASE_DOMAIN.
# Set it when the platform runs on an IP address or port instead of a domain.
HOSTING_CONTACT_EMAIL=
# Optional status page, linked from transactional emails.
HOSTING_STATUS_URL=
BW_SOURCE_URL=https://github.com/BananaSuite/BananaWiki
