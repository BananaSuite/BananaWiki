# BananaWiki compose example for Caddy 2. Generated by bananawiki.ops.caddy.example('compose');
# managed servers get the same file from `bananawiki proxy`. Set the {$VARIABLES} in Caddy's environment.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
	}
}

{$WIKI_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy wiki:5001 {
		flush_interval -1
		header_up -X-Forwarded-Prefix
	}
}
