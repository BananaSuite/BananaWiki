[Unit]
Description=BananaWiki Legacy Domain Redirect
Documentation=https://github.com/BananaSuite/BananaWiki
After=network.target

[Service]
Type=simple
User=bananawiki
Group=bananawiki
WorkingDirectory=/opt/bananawiki
# Edit both lines before enabling the service.  LEGACY_OLD_DOMAINS is the
# comma-separated list of domains you are moving away from; add more as needed.
Environment=LEGACY_OLD_DOMAINS=old.example.com
Environment=LEGACY_NEW_DOMAIN=wiki.example.net
Environment=LEGACY_BIND_PORT=8090
ExecStart=/opt/bananawiki/venv/bin/python -m legacy_redirect
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
