# BananaWiki configuration example. Every setting is optional unless noted.
# BananaWiki reads them from its environment only (it does not load a .env file):
# export them or use the service's environment file. docs/configuration.md
# explains each one; managed installations keep them in config/app.env.
# Values shown are literal defaults where the documentation gives one.

# --- Where the wiki keeps its data ---
# BW_INSTANCE_DIR=
# BW_DATABASE_PATH=
# BW_UPLOAD_FOLDER=
# BW_FAVICON_UPLOAD_FOLDER=
# BW_ATTACHMENT_FOLDER=
# BW_CHAT_ATTACHMENT_FOLDER=
# BW_KANBAN_ATTACHMENT_FOLDER=
# BW_CUSTOM_PAGE_FILES_FOLDER=
# BW_TTS_FOLDER=
# BW_TTS_PIPER_VOICE_DIR=
# BW_SITE_EXPORT_TEMP_DIR=
# BW_EXTERNAL_PLUGINS_DIR=
# BW_LOG_FILE=

# --- Core settings ---
# BW_ENV=production
# BW_SECRET_KEY=
# BW_SETUP_TOKEN=
# BW_HOST=127.0.0.1
# BW_PORT=5001
# BW_PROXY_MODE=0
# BW_PREFERRED_URL_SCHEME=
# BW_SESSION_COOKIE_NAME=bw_session
# BW_SECURE_COOKIES=
# BW_PASSWORD_HASH_METHOD=auto
# BW_SOURCE_URL=https://github.com/BananaSuite/BananaWiki
# BW_LOGGING_LEVEL=medium
# BW_LOG_FORMAT=text
# BW_DEFAULT_INTERFACE_LANGUAGE=en
# BW_BACKGROUND_JOBS=1
# BW_MAINTENANCE_FILE=

# --- Limits ---
# BW_MAX_CONTENT_LENGTH_BYTES=
# BW_MAX_ATTACHMENT_SIZE_BYTES=
# BW_BACKGROUND_IMAGE_MAX_UPLOAD_SIZE_BYTES=
# BW_BACKGROUND_IMAGE_MAX_PIXELS=16000000
# BW_BACKGROUND_IMAGE_MAX_DIMENSION=
# BW_MIN_FORM_SECONDS=
# BW_MEMORY_LIMIT_MB=
# BW_NOFILE_LIMIT=

# --- Database tuning ---
# BW_DB_BUSY_TIMEOUT_MS=
# BW_DB_CACHE_KIB=
# BW_DB_SYNCHRONOUS=full
# BW_DB_INTEGRITY_CHECK_INTERVAL_SECONDS=3600

# --- Features and plugins ---
# BW_FEDERATION_ENABLED=0
# BW_ALLOW_SITE_IMPORT=
# Third-party plugins (code with the wiki's full rights; only the owner and
# superusers install or enable them). Off unless set to 1; when unset, an
# upgraded installation that already has plugins keeps them (with a warning).
# BW_ALLOW_EXTERNAL_PLUGINS=0
# BW_PLUGIN_ISOLATION=
# BW_MANAGED_PLUGIN_DENYLIST=
# BW_EASY_WIKI=0

# --- Email ---
# BW_MAIL_PROVIDER=
# BW_MAIL_FROM=
# BW_MAIL_REPLY_TO=
# BW_MAIL_API_KEY=
# BW_SMTP_HOST=
# BW_SMTP_PORT=587
# BW_SMTP_SECURITY=
# BW_SMTP_USERNAME=
# BW_SMTP_PASSWORD=
# BW_MAIL_TIMEOUT=
# BW_MAIL_DAILY_LIMIT=
# BW_BASE_URL=

# --- Hosting platform (set by the host) ---
# BW_MANAGED_HOSTING=0
# BW_HOSTED_MODE=0
# BW_FORBID_PUBLIC_MODE=0
# BW_FORBID_PAGE_BUILDER=0
# BW_FORBID_PUBLIC_BUILDER_PAGES=
# BW_MANAGED_TTS_DISABLED=0
# BW_STORAGE_LIMIT_BYTES=
# BW_PLATFORM_UPLOAD_BLACKLIST=
# BW_PLATFORM_INSTANCE_ID=
# BW_INSTANCE_EXPIRES_AT=
# BW_EASY_DEPLOYMENT=0
# BW_PLATFORM_OAUTH_ENABLED=0

# --- Web server (Gunicorn) ---
# BW_WORKERS=
# BW_THREADS=
# BW_WORKER_TIMEOUT=
# BW_WRITE_TIMEOUT=300
# BW_ACCESS_LOG=-

# --- Read aloud (text-to-speech) ---
# BW_TTS_BACKEND=
# BW_TTS_INLINE_WORKER=0
# BW_TTS_WORKER_COUNT=
# BW_TTS_MANUAL_MAX_ACTIVE_JOBS=1
# BW_TTS_MANUAL_MAX_ACTIVE_PER_USER=1
# BW_TTS_MIN_START_INTERVAL_SECONDS=
# BW_TTS_MAX_AUTO_RESUME_ATTEMPTS=
# BW_TTS_AUTO_RESUME_BASE_DELAY_SECONDS=
# BW_TTS_MAX_JOB_SECONDS=3600
# BW_TTS_PIPER_MEMORY_MB=0
# BW_TTS_AUTO_RESUME_MAX_DELAY_SECONDS=
# BW_TTS_RATE_LIMIT_COOLDOWN_SECONDS=900
# BW_TTS_SHUTDOWN_GRACE_SECONDS=20
# BW_TTS_PERFORMANCE_MODE=
# BW_TTS_PIPER_AUTO_DOWNLOAD=1
# BW_TTS_PIPER_VOICE_MAP=
# BW_TTS_PIPER_OUTPUT_FORMAT=auto
# BW_TTS_PIPER_LENGTH_SCALE=
# BW_TTS_PIPER_NOISE_SCALE=
# BW_TTS_PIPER_NOISE_W_SCALE=
# BW_TTS_FFMPEG=
# BW_TTS_REMOTE_GPU_URL=
# BW_TTS_REMOTE_GPU_AUTH_TOKEN=
# BW_TTS_REMOTE_GPU_TIMEOUT=120
# BW_TTS_WORKER_LOG_LEVEL=INFO

